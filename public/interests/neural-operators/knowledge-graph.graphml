ttps://arxiv.org/abs/2301.04104</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e499" source="pno-2024" target="area:robotics"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Learns the map from spatial cost functions to motion-planning value functions, motivated by an Eikonal PDE.</data><data key="evidence_url">https://arxiv.org/abs/2410.17547</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e500" source="vjepa2-2025" target="area:robotics"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Combines video representation learning with action-conditioned post-training for robot planning.</data><data key="evidence_url">https://arxiv.org/abs/2506.09985</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e501" source="soft-robot-2026" target="area:robotics"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Learns a differentiable actuation-to-shape operator and composes it with task maps for inverse kinematics.</data><data key="evidence_url">https://arxiv.org/abs/2602.18655</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e502" source="world-models-2018" target="area:world"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Learns a compact predictive environment model and trains a controller using that representation.</data><data key="evidence_url">https://arxiv.org/abs/1803.10122</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e503" source="gns-2020" target="area:world"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Learns particle-based physical simulation across materials using graph-network interactions.</data><data key="evidence_url">https://arxiv.org/abs/2002.09405</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e504" source="dreamerv3-2023" target="area:world"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Learns latent dynamics and improves an actor through imagined trajectories across control domains.</data><data key="evidence_url">https://arxiv.org/abs/2301.04104</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e505" source="vjepa2-2025" target="area:world"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Combines video representation learning with action-conditioned post-training for robot planning.</data><data key="evidence_url">https://arxiv.org/abs/2506.09985</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e506" source="vjepa21-2026" target="area:world"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Develops dense video/image representations through revised predictive objectives and reports downstream visual and robot evaluations.</data><data key="evidence_url">https://arxiv.org/abs/2603.14482</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e507" source="poseidon-2024" target="area:foundation"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Pretrains a PDE model and adapts it to downstream physical problems.</data><data key="evidence_url">https://arxiv.org/abs/2405.19101</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e508" source="composition-2026" target="area:foundation"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Pretrains local operators and adapts a lightweight composition module to changed domains or conditions.</data><data key="evidence_url">https://arxiv.org/abs/2609.03069</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e509" source="cs-generative-2017" target="area:inverse"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Uses the range of a generative model as a prior for recovering signals from limited measurements.</data><data key="evidence_url">https://arxiv.org/abs/1703.03208</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e510" source="seismic-2021" target="area:inverse"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Studies neural-operator surrogates for wave propagation and seismic inversion.</data><data key="evidence_url">https://arxiv.org/abs/2108.05421</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e511" source="nio-2023" target="area:inverse"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Combines operator-learning components for PDE inverse problems where observations encode an operator-valued measurement map.</data><data key="evidence_url">https://arxiv.org/abs/2301.11167</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e512" source="em-design-2023" target="area:inverse"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Uses a neural-operator surrogate for repeated electromagnetic evaluation during inverse design.</data><data key="evidence_url">https://arxiv.org/abs/2302.01934</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e513" source="nfm-2024" target="area:timeseries"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Models time series in the frequency domain, including evaluation under changed sampling rates.</data><data key="evidence_url">https://arxiv.org/abs/2410.04703</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e514" source="deepvivonet-2025" target="area:timeseries"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Uses marine-riser field data for sparse reconstruction and forecasting, then optimizes sensor placement with an outer loop.</data><data key="evidence_url">https://arxiv.org/abs/2501.04105</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e515" source="manufacturing-2025" target="area:timeseries"><data key="relation">bridges_field</data><data key="epistemic_status">curated_classification</data><data key="evidence">Combines operator and recurrent components to predict distortion from thermal history, with physics-based training constraints.</data><data key="evidence_url">https://arxiv.org/abs/2511.13178</data><data key="evidence_locator">Broad field classification based on stated method/application; not a novelty claim</data></edge><edge id="e516" source="principled-2026" target="gino-2023"><data key="relation">cites</data><data key="epistemic_status">documented</data><data key="evidence">Explicit numbered reference in the supplied 2026 paper.</data><data key="evidence_url">https://www.nature.com/articles/s42256-026-01267-z</data><data key="evidence_locator">Reference 9, journal pp. 1180–1181</data></edge><edge id="e517" source="principled-2026" target="fno-discretization-2024"><data key="relation">cites</data><data key="epistemic_status">documented</data><data key="evidence">Explicit numbered reference in the supplied 2026 paper.</data><data key="evidence_url">https://www.nature.com/articles/s42256-026-01267-z</data><data key="evidence_locator">Reference 13, journal pp. 1180–1181</data></edge><edge id="e518" source="principled-2026" target="neuralop-library-2024"><data key="relation">cites</data><data key="epistemic_status">documented</data><data key="evidence">Explicit numbered reference in the supplied 2026 paper.</data><data key="evidence_url">https://www.nature.com/articles/s42256-026-01267-z</data><data key="evidence_locator">Reference 14, journal pp. 1180–1181</data></edge><edge id="e519" source="principled-2026" target="fno-2020"><data key="relation">cites</data><data key="epistemic_status">documented</data><data key="evidence">Explicit numbered reference in the supplied 2026 paper.</data><data key="evidence_url">https://www.nature.com/articles/s42256-026-01267-z</data><data key="evidence_locator">Reference 15, journal pp. 1180–1181</data></edge><edge id="e520" source="principled-2026" target="practical-fno-2025"><data key="relation">cites</data><data key="epistemic_status">docume