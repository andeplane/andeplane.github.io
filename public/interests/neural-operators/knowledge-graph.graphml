s">documented</data><data key="evidence">Matched the paper title (or documented title variant) in the downloaded bibliography.</data><data key="evidence_url">https://arxiv.org/abs/2603.14482</data><data key="evidence_locator">Downloaded PDF page 25; see metadata/citations.json for bibliographic context</data><data key="evidence_file">vjepa21-2026.pdf</data><data key="evidence_page">25</data></edge><edge id="e639" source="deeponet-2019" target="chen-1995"><data key="relation">theoretical_precursor</data><data key="epistemic_status">analyst_inference</data><data key="evidence">DeepONet explicitly motivates its architecture through operator universal approximation.</data><data key="evidence_url">https://arxiv.org/abs/1910.03193</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e640" source="cs-polynomials-2017" target="stable-cs-2005"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Sparse polynomial recovery uses the sparse-reconstruction framework; assumptions on samples remain essential.</data><data key="evidence_url">https://arxiv.org/abs/1703.06987</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e641" source="cs-polynomials-2017" target="sparse-operators-2012"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Sparse approximation of functions and sparse identification of operators suggest complementary approaches, but their model classes differ.</data><data key="evidence_url">https://arxiv.org/abs/1703.06987</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e642" source="operator-sampling-2024" target="cs-polynomials-2017"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Moves from high-dimensional function approximation to information limits for operator-valued learning.</data><data key="evidence_url">https://arxiv.org/abs/2410.23440</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e643" source="optimal-sampling-2024" target="cs-polynomials-2017"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Continues the sampling/approximation thread through weighted least squares and approximation-space-aware sampling.</data><data key="evidence_url">https://arxiv.org/abs/2409.02342</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e644" source="nonlinear-sampling-2024" target="cs-generative-2017"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">The newer framework explicitly includes compressed sensing with generative models.</data><data key="evidence_url">https://proceedings.mlr.press/v235/adcock24a.html</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e645" source="theory-tour-2026" target="operator-sampling-2024"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">A useful complementary view of sample-complexity limits; not an assertion that the survey covers the September revision.</data><data key="evidence_url">https://arxiv.org/abs/2603.00819</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e646" source="theory-tour-2026" target="neural-operator-2021"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Places operator expressivity alongside statistical and approximation-rate questions.</data><data key="evidence_url">https://arxiv.org/abs/2603.00819</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e647" source="deim-2009" target="eim-2004"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Discrete empirical interpolation develops selected-entry approximation for reduced nonlinear models.</data><data key="evidence_url">https://laertes.caam.rice.edu/tech_reports/2009/TR09-05.pdf</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e648" source="ecm-2017" target="deim-2009"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Both reduce costly nonlinear evaluation; cubature targets integrals while DEIM approximates nonlinear vectors.</data><data key="evidence_url">https://upcommons.upc.edu/handle/2117/91502?locale-attribute=en</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e649" source="cecm-2023" target="ecm-2017"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Extends empirical cubature by permitting point locations to move.</data><data key="evidence_url">https://arxiv.org/abs/2308.03877</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e650" source="adaptive-cubature-2026" target="ecm-2017"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Allows weights to vary with latent state instead of remaining fixed over the manifold.</data><data key="evidence_url">https://arxiv.org/abs/2609.03068</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e651" source="adaptive-cubature-2026" target="cecm-2023"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Related empirical-cubature development with shared authors; adaptive weights and movable points are distinct freedoms.</data><data key="evidence_url">https://arxiv.org/abs/2609.03068</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e652" source="kno-2024" target="cecm-2023"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Hypothesis: fit empirical cubature rules to the integrand families of a trained KNO.</data><data key="evidence_url">https://arxiv.org/abs/2407.00809</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e653" source="kno-2024" target="adaptive-cubature-2026"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Hypothesis: use state-dependent weights to reduce kernel evaluations; the cubature paper does not test this neural-operator application.</data><data key="evidence_url">https://arxiv.org/abs/2407.00809</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e654" source="learnable-quadrature-2025" target="kno-2024"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Training-loss quadrature and inference-layer quadrature could exchange techniques, but their objectives differ.</data><data key="evidence_url">https://papers.neurips.cc/paper_files/paper/2025/hash/382b95a6580cfb0b5ca33c74b4e0e770-Abstract-Conference.html</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e655" source="acoustic-quadrature-2026" target="principled-2026"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Both use coordinate-aware weighted integration; dates alone do not establish citation or influence.</data><data key="evidence_url">https://arxiv.org/abs/2607.04407</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e656" source="acoustic-quadrature-2026" target="cecm-2023"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Potential sparse-rule application for a learned boundary integrand; not demonstrated by these papers together.</data><data key="evidence_url">https://arxiv.org/abs/2607.04407</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e657" source="frame-kernel-2026" target="cs-polynomials-2017"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Coefficient-space operator learning offers a testbed for sparsity assumptions; frame structure alone does not establish compressed-sensing guarantees.</data><data key="evidence_url">https://arxiv.org/abs/2608.25084</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e658" source="frame-kernel-2026" target="kno-2024"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Both investigate kernel-based alternatives to common neural operators, with different representations.</data><data key="evidence_url">https://arxiv.org/abs/2608.25084</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e659" source="fno-2020" target="graph-kernel-2020"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Two early efficient parameterizations of function-space kernel interactions.</data><data key="evidence_url">https://arxiv.org/abs/2010.08895</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e660" source="neural-operator-2021" target="fno-2020"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">The foundational treatment includes Fourier operators among its architecture classes.</data><data key="evidence_url">https://arxiv.org/abs/2108.08481</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e661" source="fno-discretization-2024" target="fno-2020"><data key="relation">analyzes</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Studies finite-grid evaluation error in the Fourier neural operator.</data><data key="evidence_url">https://arxiv.org/abs/2405.02221</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e662" source="fourcastnet-2022" target="fno-2020"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Adaptive Fourier operator processing brings spectral operator ideas to global forecasting.</data><data key="evidence_url">https://arxiv.org/abs/2202.11214</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e663" source="sfno-2023" target="fourcastnet-2022"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Atmospheric modeling motivates spherical rather than flat spectral geometry.</data><data key="evidence_url">https://arxiv.org/abs/2306.03838</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e664" source="fourcastnet3-2025" target="sfno-2023"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Continues the geometric weather-modeling program with probabilistic spherical convolution; not an identical SFNO architecture.</data><data key="evidence_url">https://arxiv.org/abs/2507.12144</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e665" source="poseidon-2024" target="fno-2020"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Moves beyond single-problem operator fitting toward pretrained PDE models.</data><data key="evidence_url">https://arxiv.org/abs/2405.19101</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e666" source="composition-2026" target="poseidon-2024"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Two routes toward cheaper adaptation: broad pretraining and local modular composition.</data><data key="evidence_url">https://arxiv.org/abs/2609.03069</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e667" source="gino-2023" target="fno-2020"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Combines graph transformations with a regular latent Fourier representation.</data><data key="evidence_url">https://arxiv.org/abs/2309.00583</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e668" source="u-fno-2021" target="fno-2020"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Extends Fourier operator processing for multiphase subsurface flow.</data><data key="evidence_url">https://arxiv.org/abs/2109.03697</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e669" source="seismic-2021" target="fno-2020"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Applies Fourier operator learning to seismic forward and inverse problems.</data><data key="evidence_url">https://arxiv.org/abs/2108.05421</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e670" source="em-design-2023" target="fno-2020"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Uses operator surrogates for repeated electromagnetic design evaluation.</data><data key="evidence_url">https://arxiv.org/abs/2302.01934</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e671" source="nio-2023" target="deeponet-2019"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Combines DeepONet and FNO components for inverse operator mappings.</data><data key="evidence_url">https://arxiv.org/abs/2301.11167</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e672" source="nio-2023" target="fno-2020"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Combines DeepONet and FNO components for inverse operator mappings.</data><data key="evidence_url">https://arxiv.org/abs/2301.11167</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e673" source="deepvivonet-2025" target="deeponet-2019"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Uses a DeepONet-based model for marine-riser dynamics.</data><data key="evidence_url">https://arxiv.org/abs/2501.04105</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e674" source="deepvivonet-2025" target="cecm-2023"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Both select points, but physical sensor optimization and integrand subsampling solve different problems.</data><data key="evidence_url">https://arxiv.org/abs/2501.04105</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e675" source="pno-2024" target="fno-2020"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Uses operator learning to approximate a motion-planning value-function map.</data><data key="evidence_url">https://arxiv.org/abs/2410.17547</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e676" source="pde-control-2023" target="deeponet-2019"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Uses DeepONet to approximate a controller-design operator.</data><data key="evidence_url">https://arxiv.org/abs/2307.11436</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e677" source="soft-robot-2026" target="pno-2024"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Direct robotics applications with different outputs: physical shape versus planning value.</data><data key="evidence_url">https://arxiv.org/abs/2602.18655</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e678" source="soft-robot-2026" target="vjepa2-2025"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Hypothesis: combine a field/shape predictor with a perceptual action-conditioned planning system.</data><data key="evidence_url">https://arxiv.org/abs/2602.18655</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e679" source="gns-2020" target="soft-robot-2026"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Graph-based physical simulation is a relevant comparator for learned deformable-body models.</data><data key="evidence_url">https://arxiv.org/abs/2002.09405</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e680" source="dreamerv3-2023" target="world-models-2018"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Both learn latent predictive environments for control; represents a reading lineage, not a verified citation edge.</data><data key="evidence_url">https://arxiv.org/abs/2301.04104</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e681" source="vjepa2-2025" target="dreamerv3-2023"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Both support action-conditioned planning or learning, but representation objectives and control procedures differ.</data><data key="evidence_url">https://arxiv.org/abs/2506.09985</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e682" source="vjepa21-2026" target="vjepa2-2025"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Direct continuation of the V-JEPA model family toward dense representations.</data><data key="evidence_url">https://arxiv.org/abs/2603.14482</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e683" source="manufacturing-2025" target="deeponet-2019"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Uses a DeepONet/recurrent formulation for thermal-history to distortion prediction.</data><data key="evidence_url">https://arxiv.org/abs/2511.13178</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e684" source="ultrasound-2024" target="deeponet-2019"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Uses a convolutional DeepONet for acoustic field prediction.</data><data key="evidence_url">https://arxiv.org/abs/2412.16118</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e685" source="nfm-2024" target="fno-2020"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Frequency-domain time-series modeling is an adjacent baseline, not automatically the same operator formulation.</data><data key="evidence_url">https://arxiv.org/abs/2410.04703</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e686" source="sindy-2015" target="sparse-operators-2012"><data key="relation">conceptual_bridge</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Both identify structured dynamics, but sparse evolution laws differ from sparse linear operators.</data><data key="evidence_url">https://arxiv.org/abs/1509.03580</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge><edge id="e687" source="pdebench-2022" target="well-2024"><data key="relation">method_connection</data><data key="epistemic_status">analyst_inference</data><data key="evidence">Complementary simulation benchmarks, with The Well broadening the range of physical behavior.</data><data key="evidence_url">https://arxiv.org/abs/2210.07182</data><data key="evidence_locator">Abstract/method comparison; analyst reading link, not a verified citation</data></edge></graph></graphml>