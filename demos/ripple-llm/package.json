{
  "name": "ripple-llm",
  "version": "1.0.0",
  "private": true,
  "description": "Matrix multiplication and a tiny language model computed by inverse-designed ripple tanks",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm test && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "train": "node --experimental-strip-types --no-warnings tools/train.ts",
    "design": "node --experimental-strip-types --no-warnings tools/design-tanks.ts"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
