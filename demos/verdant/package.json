{
  "name": "verdant-research-station",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm test && tsc -b && vite build && npm run build:engine",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "headless": "tsx scripts/headless.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "build:engine": "esbuild src/core.ts --bundle --platform=neutral --format=esm --target=es2022 --outfile=dist-engine/verdant.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
